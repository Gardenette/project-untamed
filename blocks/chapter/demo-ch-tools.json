[{"id":"352250af-500d-4a10-9a23-efdbd2f1c534","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Foma is equipped with many tools to close the distance between planning, organizing, writing, and revising your story. In this chapter, we'll review Foma's most powerful workflow and quality-of-life tools.","styles":{}}],"children":[]},{"id":"d27f0fbc-8d5a-4106-ac32-9738faf5875d","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"fb4e91f0-a657-4aa2-8771-2d48e4b2c03e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"In this chapter, try:","styles":{}}],"children":[]},{"id":"852d4ea3-aa0a-4d4b-b527-235ab587713a","type":"checkListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","checked":false},"content":[{"type":"text","text":"/dump","styles":{"code":true}},{"type":"text","text":" a stray idea mid-scene, then ","styles":{}},{"type":"text","text":"/sift","styles":{"code":true}},{"type":"text","text":" it back into the draft. ","styles":{}}],"children":[]},{"id":"bad9e2de-13ff-446a-b033-bd535c46f9ad","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"this is a dump this is a sprint. I guess.","styles":{}}],"children":[]},{"id":"db07a553-00ab-4ec4-a600-2d11905bbd73","type":"checkListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","checked":false},"content":[{"type":"text","text":"/focus","styles":{"code":true}},{"type":"text","text":" for a clean writing surface; ","styles":{}},{"type":"text","text":"/dim","styles":{"code":true}},{"type":"text","text":" inside Focus Mode to fade out everything except for the paragraph in-progress.","styles":{}}],"children":[]},{
[{"id":"f7c89bef-e168-4a4a-8892-ea3b8575ce20","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Welcome to the Foma interactive tutorial! ","styles":{}}],"children":[]},{"id":"191c7906-b317-4850-a40d-6fc0fdf508b1","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"In this project, you'll learn the basics of how Foma is organized and how you can use it to get the most out of the time that you spend planning and writing your stories.","styles":{}}],"children":[]},{"id":"ad628001-d13a-45a2-b5fa-6b06d138098b","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"The Basics","styles":{}}],"children":[]},{"id":"43004592-6812-470a-b999-4f40baea128e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Foma contains four writing ","styles":{}},{"type":"text","text":"domains ","styles":{"italic":true}},{"type":"text","text":"that connect to each other to help you keep your research, planning, literary notes, and manuscript organized and easy to read between. ","styles":{}}],"children":[]},{"id":"86bceb6b-c93e-4fc0-9270-2307ca92f2e0","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Three of the ","styles":{}},{"type":"text","text":"domains ","styles":{"italic":true}},{"type":"text","text":"are represented by the three distinct sections of the side bar navigation panel to the left: Manuscript, Worldbuilding, and Threads. The fourth domain is accessible by clicking the ","styles":{}},{"type":"text","text":"Notebooks ","styles":{"italic":true}},{"type":"text","text":"button on the left side of the title bar (or by typing ","styles":{}},{"type":"text","text":"/notebooks","styles":{"code":true}},{"type":"text","text":" in the editor). ","styles":{}}],"children":[]},{"id":"64b8769d-00ec-4750-af82-0f9136a71641","type":"callout","props":{"textAlignment":"left","textColor":"default","icon":"💬"},"content":[{"type":"text","text":"NOTE: if you do not see the side bar to the left, click the \"show sidebar\" button in the upper-left corner of the screen.","styles":{"italic":true}}],"children":[]},{"id":"75a18b25-2aa7-48b0-9136-bdc980a6172b","type":"image","props":{"textAlignment":"center","backgroundColor":"default","name":"image-107.png","url":"assets/image-107.png","caption":"Open or close the sidebar","showPreview":true},"children":[]},{"id":"e5608c45-bf5f-4866-a020-773ded7d63a6","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"e972c128-9f86-4d79-83e5-f51a04bf6e88","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Domains","styles":{}}],"children":[]},{"id":"5b4c1e06-6047-4a11-b93f-b559fad479d0","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"We'll go into each domain in more detail later, but here's the tl;dr:","styles":{}}],"children":[]},{"id":"ad2080f6-042f-48df-a0a0-c0dc08e1c989","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Manuscript","styles":{"code":true}},{"type":"text","text":" is where your chapters and scenes go.","styles":{}}],"children":[]},{"id":"f89df434-8af2-4927-b033-2331ea6f7ddd","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Worldbuilding","styles":{"code":true}},{"type":"text","text":" is where you create character sheets, lore, locations, and blocks for any named thing in your story.","styles":{}}],"children":[]},{"id":"9e77d2f2-77d2-4b4d-9d0f-ef7d3f3d50af","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Threads","styles":{"code":true}},{"type":"text","text":" is where you manage the literary moves that develop over the course of your story. For example: create a ","styles":{}},{"type":"text","text":"foreshadowing Thread","styles":{"italic":true}},{"type":"text","text":", ","styles":{}},{"type":"text","text":"pin","styles":{"code":true}},{"type":"text","text":" the sentence that foreshadows something in Act 1, then ","styles":{}},{"type":"text","text":"pin","styles":{"code":true}},{"type":"text","text":" the sentence in Act 3 that fulfills the payoff. ","styles":{}}],"children":[]},{"id":"5b6df6ff-8731-4ba5-96b2-4934189d377d","type":"bulletListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Notebooks","styles":{"code":true}},{"type":"text","text":" are loose collections that are designed for research, brainstorming, writing exercises, or whatever you need them for.","styles":{}}],"children":[]},{"id":"81e54f2f-7e5a-4ac5-91cb-1773d249897a","type":"image","props":{"textAlignment":"center","backgroundColor":"default","name":"image-108.png","url":"assets/image-108.png","caption":"Open notebooks here","showPreview":true},"children":[]},{"id":"f6204676-5d4c-4746-bbcd-db38376e3711","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Blocks","styles":{}}],"children":[]},{"id":"4875f699-ff3a-46a1-b020-6da08d0fb364","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Every object in the side bar is a ","styles":{}},{"type":"text","text":"block","styles":{"code":true}},{"type":"text","text":". Every block can be opened in the editor. Think of blocks as containers. Write on them—and in them—as you see fit. Most blocks can also nest blocks of other types or reference other blocks in various ways (we'll go into those ways later as well).","styles":{}}],"children":[]},{"id":"e263875d-dc12-4ce3-a582-4ed0e5cf994d","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"This paragraph lives in  ","styles":{}},{"type":"text","text":"Chapter block","styles":{"italic":true}},{"type":"text","text":".","styles":{}}],"children":[]},{"id":"57fdca6b-57c4-47ab-8af8-d73c107bec62","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Chapter blocks are planning containers. These notes live outside the manuscript body, so they are a good place for summaries, outlines, continuity notes, and reminders.","styles":{}}],"children":[]},{"id":"bd086ffd-7fcc-4908-8b08-c8c86f78569d","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-109.png","url":"assets/image-109.png","caption":"Chapter blocks have the open folder icon","showPreview":true},"children":[]},{"id":"390da51b-e12e-441a-8b79-0c13978c9020","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"In this demo, every chapter's notes hold a short list of things to try. Open the nested scene named ","styles":{}},{"type":"text","text":"How to use this demo","styles":{"italic":true}},{"type":"text","text":" first, then work through the chapters in order.","styles":{}}],"children":[]},{"id":"1224301d-0de0-4364-994b-8104a18d32b3","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"9af8c23a-d389-417b-92d2-e0a9891da38a","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Or jump around, I'm not here to control your life.","styles":{}}],"children":[]},{"id":"cbf4d1f4-5625-47b2-afc4-939592bdbd6f","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]}]
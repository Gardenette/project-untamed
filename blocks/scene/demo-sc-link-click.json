f-4783-8c05-31679ef92231","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"As you write your character sheets or other ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":"text","text":" blocks, you may find that you're re-writing a lot of common structures. If you find that your character sheets follow the same structure each time you create a new one, consider creating a ","styles":{}},{"type":"text","text":"Template ","styles":{"italic":true}},{"type":"text","text":"instead. Foma comes pre-loaded with several basic ","styles":{}},{"type":"text","text":"Templates ","styles":{"italic":true}},{"type":"text","text":"for various ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":"text","text":" classes, but you may find that you prefer to create your own. ","styles":{}}],"children":[]},{"id":"5205e268-93be-4025-9aec-546527673beb","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"7c76bee5-1033-4df2-8007-c53d1d0d72ab","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"To access the Template Library, click the Template Library icon in the upper-left corner of the title bar:","styles":{}}],"children":[]},{"id":"f0da198b-2a5e-4d2a-924e-68d953f3f455","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-95.png","url":"assets/image-95.png","caption":"Template Library","showPreview":true},"children":[]},{"id":"efccc422-7a14-425c-9439-d65bc90afad8","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"515a1ce0-a367-4812-aa58-f71a78c70ad2","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The Template Library allows you to create new Templates or copy existing templates to modify for your own purposes.","styles":{}}],"children":[]},{"id":"348c032a-feba-4309-a6ed-dd8fa1a9cefb","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-94.png","url":"assets/image-94.png","caption":"The Template Library lets you inspect existing templates, create new, or create copies to modify","showPreview":true},"children":[]},{"id":"5c797020-58a8-46fb-9a0c-5db47e078f93","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"09baa982-fdd4-46cd-9c58-44bb27ee4bea","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Creating Templates from Existing Actants","styles":{}}],"children":[]},{"id":"b481ad3d-abd8-4860-9abb-fa2f74677c30","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"You may find that, during the course of creating a Character Page, that you like the layout that you've created and you'd like to turn that character page into a Template, but stripped of information that is specific to the ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":"text","text":" that you've already written.","styles":{}}],"children":[]},{"id":"266702bd-ad5b-44e0-9cd9-fb5d8fc8cf47","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"f47a1127-db23-45d7-87a1-9e8c7b27eb0f","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"To turn an existing ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":"text","text":" page into a template, simply type ","styles":{}},{"type":"text","text":"/template","styles":{"code":true}},{"type":"text","text":" while you are typing in the ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":"text","text":"'s page to create a template based on that ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":"text","text":".","styles":{}}],"children":[]},{"id":"8464a20f-1822-4902-8e84-638f501b38e8","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"5ca9735b-1818-4c87-b3aa-1c007a7f3e8e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Try this:","styles":{}}],"children":[]},{"id":"c2d20dc1-eae0-42fe-a6d0-f3e20e08de32","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Navigate to the Character ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":"text","text":" under ","styles":{}},{"type":"text","text":"Worldbuilding → Characters → Professor ","styles":{"code":true}},{"type":"fomaEmbed","props":{"blockId":"blk-0bb7736f-8c81-40a6-86f9-599c47362123","blockTitle":"Gregory","blockType":"actant","bold":"false","italic":"false","strikethrough":"false","code":"true"}},{"type":"text","text":". In an empty line, type ","styles":{}},{"type":"text","text":"/template","styles":{"code":true}},{"type":"text","text":" and select ","styles":{}},{"type":"text","text":"Save as Template","styles":{"code":true}},{"type":"text","text":":","styles":{}}],"children":[]},{"id":"05f5e61e-9bbc-48c5-a3a2-a2ae9e61119e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"fdf0a5fc-64ea-43d4-99c7-a2198e269e9a","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-
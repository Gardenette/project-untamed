nested under a Group named \"Characters\".","showPreview":true},"children":[]},{"id":"7a727bb0-b02a-4aa7-a306-f44e2c9ae962","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"96370594-8907-4ee9-9c23-9688941e7719","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Creative Actant Classes","styles":{}}],"children":[]},{"id":"17794a99-97d0-4fba-81b2-7a93f146035e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Creative ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":"text","text":" Classes are the basic building blocks of story. Foma projects have built-in Creative ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":"text","text":" Classes for Characters, Locations, Items, Concepts, and Quests.","styles":{}}],"children":[]},{"id":"93c78996-45cd-4e60-9b16-b0a740476df6","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-86.png","url":"assets/image-86.png","caption":"","showPreview":true},"children":[]},{"id":"7ebd048c-3066-40ea-9596-7d850f214238","type":"callout","props":{"textAlignment":"left","textColor":"default","icon":"💬"},"content":[{"type":"text","text":"NOTE: \"Quest\" Actants are only available by default if the project was created as a Game project. When creating a new project, select \"Game\" as the project type to begin with Quests as an available Actant Class.","styles":{"italic":true}}],"children":[]},{"id":"cad77763-f4e8-4c38-afe8-5dd47c1f13e6","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"You can set a parent ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":
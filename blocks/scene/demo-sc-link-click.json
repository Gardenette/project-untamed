[{"id":"demo-sc-link-click-p1","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The names of characters in this scene are ","styles":{}},{"type":"text","text":"more ","styles":{"italic":true}},{"type":"text","text":"than just names. They are linked to ","styles":{}},{"type":"text","text":"Actants","styles":{"italic":true}},{"type":"text","text":".","styles":{}}],"children":[]},{"id":"3b2e13da-8662-4721-b594-3bfc4e033111","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Actants ","styles":{"italic":true}},{"type":"text","text":"are the named things that make up your story. Your characters, locations, symbols, important items, factions, historical events, or really anything that you determine is important enough to give a name can be created as an ","styles":{}},{"type":"text","text":"Actant","styles":{"italic":true}},{"type":"text","text":" in the ","styles":{}},{"type":"text","text":"Worldbuilding","styles":{"code":true}},{"type":"text","text":" domain.","styles":{}}],"children":[]},{"id":"91c0d137-6b7c-4582-bb84-d97177a65f43","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"838f41fe-fec0-415f-97e4-6f56089a50ae","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Actant Classes","styles":{}}],"children":[]},{"id":"25d498c6-7cff-4bfb-8ddc-22dc2e9ee6c2","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Actants ","styles":{"italic":true}},{"type":"text","text":"are generic blocks of text that are categorized by their ","styles":{}},{"type":"text","text":"Classes","styles":{"italic":true}},{"type":"text","text":". The
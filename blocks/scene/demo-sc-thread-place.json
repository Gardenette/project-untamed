[{"id":"9b142625-d599-4b3d-ae16-ead23c72cd1f","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"One pin in this project is deliberately unplaced. It belongs to the ","styles":{}},{"type":"text","text":"Thread","styles":{"italic":true}},{"type":"text","text":" \"Practice: place the loose pin\". \nClick on the 'eye' toggle to view the pins that are assigned to this scene. You should see this:","styles":{}}],"children":[]},{"id":"5d220ac4-8bf6-48ef-a666-2b0a76b27958","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-8.png","url":"assets/image-8.png","caption":"","showPreview":true},"children":[]},{"id":"10d37a0c-8421-4e95-bd0f-bd4f3d1ad7ab","type":"divider","props":{},"children":[]},{"id":"a9244dec-6393-4a89-bfbc-2daab1108739","type":"callout","props":{"textAlignment":"left","textColor":"default","icon":"💬"},"content":[{"type":"text","text":"Try this: open the Pincushion (the floating pin icon in the editor) and find the unplaced pin. Drag it into a paragraph here to anchor it. That is the whole workflow: decide where a Thread touches the draft, then drop the pin there.","styles":{"italic":true}}],"children":[]},{"id":"eb00c29c-89f2-4588-9b66-6eed4a69eb40","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Place the pin on this line.","styles":{"textColor":"red"}}],"children":[]},{"id":"79426310-88f9-4670-8898-6a364ef886d3","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"After placing it, type ","styles":{}},{"type":"text","text":"/threads","styles":{"code":true}},{"type":"text","text":" and select the practice ","styles":{}},{"type":"text","text":"Thread","styles":{"italic":true}},{"type":"text","text":" to see its pin list update.","styles":{}}],"children":[]},{"id":"57fd433a-68b5-4b1a-b8ef-4a7ff79d1a76","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"63b113ff-4359-4587-b834-c0a607503415","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]}]
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Pins can be filtered by role by clicking the filters across the top of the story arc page.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "2420d70b-5e74-4ff8-9833-c39e50a1f6ee",
    "type": "paragraph",
    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Example: clicking the Setup / Payoff filter will highlight only Setup / Payoff pins.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "c6318b3c-36be-4dca-a3f9-dbd0847c0481",

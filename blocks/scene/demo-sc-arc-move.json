    },
    "content": [
      {
        "type": "text",
        "text": "A scene that has pins assigned displays its pins in the Story Arc view across the bottom of the scene's card. Hover over the pin with the cursor to inspect it.",
        "styles": {}
      }
    ],
    "children": []
  },
  {

    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "To add ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Subsections",
        "styles": {
          "italic": true
        }
      },
      {
        "type": "text",
        "text": " to a ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Section",
        "styles": {
          "italic": true
        }
      },
      {
        "type": "text",
        "text": ", click the \"Folder +\" button inside of a ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Section",
        "styles": {
          "italic": true
        }
      },

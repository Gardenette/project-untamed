      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "At the core, layouts are simply ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Sections",
        "styles": {
          "italic": true
        }
      },
      {
        "type": "text",
        "text": " and ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Subsections",
        "styles": {
          "italic": true
        }
      },
      {
        "type": "text",
        "text": " in which you nest your chapters and scenes. To create a ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Section",
        "styles": {
          "italic": true
        }
      },
      {
        "type": "text",
        "text": ", click ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "+ Add Section",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " at the bottom of the Story Arc view.",
        "styles": {}
      }
    ],
    "children": []
  },

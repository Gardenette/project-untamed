      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Foma includes several default ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Layouts ",
        "styles": {
          "italic": true
        }
      },
      {
        "type": "text",
        "text": "that represent common organizational structures. By default, no layout is selected. To select a layout, click on the layout button in the upper-left corner of the screen (in this demo project, a layout has already been created for you called ",
        "styles": {}
      },
      {
        "type": "text",

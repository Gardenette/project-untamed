    "type": "paragraph",
    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Common story layouts can be configured from Templates.  Foma offers the following layouts out of the box: 3-Act Structure, 5-Act Structure, Hero's Journey, Save the Cat, or Game Structure. ",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "e5e4f0dc-6f0e-4753-9883-5445a8c143aa",
    "type": "paragraph",
    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "To change the layout of your story, click ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "New from Template",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " and select the template that fits your story and/or workflow.",
        "styles": {}
      }
    ],
    "children": []
  },

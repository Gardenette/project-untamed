    },
    "content": [
      {
        "type": "text",
        "text": "To create your own Layout, click ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "+ New Blank Layout",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": ". Once you are happy with your layout, you may save it as a template for future projects by clicking ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Save as Template",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",

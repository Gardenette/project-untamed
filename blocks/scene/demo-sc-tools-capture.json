    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "To recall ideas that were created with ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "/dump",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": ", invoke ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "/sift",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " to surface all of your brain dump ideas. Your entries are sorted by their proximity to the current active document. If you created a Brain Dump idea in Chapter 1, that idea floats to the top of your ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "/sift",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " stack while you're writing Chapter 1.",
        "styles": {}
      }
    ],
    "children": []
  },

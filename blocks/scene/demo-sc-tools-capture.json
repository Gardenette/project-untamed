    "id": "2eae66c0-2b50-441a-822c-8bb60a803c13",
    "type": "paragraph",
    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Ideas often arrive while you are busy writing something else. ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "Brain Dump",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " captures your ideas without ever leaving the scene or even taking your fingers off of the keyboard.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "92ced0a5-e408-4b50-b7c3-96bbf3e9eaae",
    "type": "paragraph",
    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Type ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "/dump",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " to quickly dump an idea without ever having to click away from the current active editor. The cursor automatically flows from the editor to your Brain Dump text area, then back to the same position within the editor when the Brain Dump is either captured or dismissed.",
        "styles": {}
      }
    ],
    "children": []
  },

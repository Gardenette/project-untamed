      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Alternatively, type ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "/sprint<n>",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " where ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "n",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " is the desired time interval. For example, ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "/sprint20",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " will enter Focus Mode and queue a 20-minute writing sprint that begins on the first keystroke.",

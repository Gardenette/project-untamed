    },
    "content": [
      {
        "type": "text",
        "text": "To adjust the size of the page in Focus Mode, hover the cursor towards the bottom of the screen. Three sizes will be revealed: ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "N",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " (narrow), ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "M",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " (medium), ",
        "styles": {}
      },
      {
        "type": "text",
        "text": "W",
        "styles": {
          "code": true
        }
      },
      {
        "type": "text",
        "text": " (wide). Your selection persists across sessions and projects.",

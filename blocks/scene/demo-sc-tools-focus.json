      "textColor": "default",
      "textAlignment": "left",
      "level": 3,
      "isToggleable": false
    },
    "content": [
      {
        "type": "text",
        "text": "Eye-Level Positioning",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "3e6d294b-320c-48ca-a7a6-3ac9c31363bd",
    "type": "paragraph",
    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "Position the caret's vertical orientation relative to your screen's size and orientation: while in Focus Mode, hover the mouse to the right edge of the screen. This reveals a vertical drag handle that you can drag to align the line that you're typing with where your eyes naturally rest on your monitor. ",
        "styles": {}
      }
    ],
    "children": []
  },

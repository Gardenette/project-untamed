      "textAlignment": "left",
      "level": 3,
      "isToggleable": false
    },
    "content": [
      {
        "type": "text",
        "text": "Typewriter Positioning",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "0c1505ca-a245-44a4-8b60-763d5db4c5e3",
    "type": "paragraph",
    "props": {
      "backgroundColor": "default",
      "textColor": "default",
      "textAlignment": "left"
    },
    "content": [
      {
        "type": "text",
        "text": "By default, Focus Mode uses Typewriter Positioning to ensure that the caret never drops below the writer's eye level. As you type in Focus mode, each new line pushes previous content up in the Editor. Your eyes only ever need to move left-to-right, never up or down while you type.",
        "styles": {}
      }
    ],
    "children": []
  },
  {
    "id": "0014167e-02dd-4cd5-92a0-c16e54192e14",
    "type": "divider",
    "props": {},
    "children": []
  },
  {

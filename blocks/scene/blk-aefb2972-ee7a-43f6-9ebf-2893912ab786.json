[{"id":"240cf7e1-d9f5-4e76-a424-8e75905c608a","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Auto-Save","styles":{}}],"children":[]},{"id":"ce6b6c84-092e-4fed-8f71-c6815c2ced26","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Foma auto-saves your work every time you stop typing.  When Foma auto-saves, it writes your changes to your local hard disk. View the current save state in the bottom right corner of the screen. ","styles":{}}],"children":[]},{"id":"1df12613-ab4a-4943-a327-bee713c0b88d","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"While you're typing, the Auto-Save indicator will read ","styles":{}},{"type":"text","text":"Typing...","styles":{"code":true}}],"children":[]},{"id":"89f5e67b-a90d-4696-8454-d84bc7df6327","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-66.png","url":"assets/image-66.png","caption":"Save state indicator while typing","showPreview":true,"previewWidth":214},"children":[]},{"id":"0d6be0e5-7c27-490c-b36b-c89d8817431e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"b9298e65-65fd-4cff-97b7-2b2ad86cabeb","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"When Foma saves the current document, a checkmark and notification that reads ","styles":{}},{"type":"text","text":"Auto-saved","styles":{"code":true}},{"type":"text","text":" appears.","styles":{}}],"children":[]},{"id":"727a3eae-a24e-4969-8138-e6bfb736524a","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-65.png","url":"assets/image-65.png","caption":"Save state indicator when finished","showPreview":true,"previewWidth":229},"children":[]},{"id":"b35b10e0-0628-469c-ba59-b34cc0066497","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"f6f01483-2431-42ad-acbc-c1f3968766bd","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Save State Indicators","styles":{}}],"children":[]},{"id":"eb47999c-da06-432c-85d0-c634b03bf59e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"After you finish typing, you may notice a colored circle next to the auto-save indicator (in Nightwriter Dark Mode, this indicator is yellow). This indicates that there are some words that have been written in the current document that have been saved to the local disk, but have not been captured by a Git Snapshot or Memory.","styles":{}}],"children":[]},{"id":"08a85b32-4389-41de-a1a4-db45be848f39","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"You may also notice colored circles next to documents in the side bar. ","styles":{}}],"children":[]},{"id":"22b1e320-ffe5-4861-a92c-b3535563fe56","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-60.png","url":"assets/image-60.png","caption":"","showPreview":true},"children":[]},{"id":"d2d919df-854e-488f-b33f-62b16f62c697","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"5e2c9aa8-df9a-4907-bfbb-8de045d9b70c","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"These circles indicate that the document has work that has been saved to the local disk, but not captured in a Git Snapshot or Memory yet.","styles":{}}],"children":[]},{"id":"dcd3ee82-3ec8-4ae4-9de6-1955f3118019","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"eaf85416-16f1-41ae-a2c8-4b2cfdb12eb0","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"When you collapse nested items in the side bar, if any of the nested contents have changes that have been saved locally but have not been captured in a Snapshot or Memory, the save state indicator rolls up to its parent.","styles":{}}],"children":[]},{"id":"c3f9454b-8e35-4d63-851e-bc4626a4e7bf","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"a7370e9b-824a-4d12-ad0f-58936962c625","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"For example, a scene under the Workflow Tools chapter has new changes that have not yet been committed to memory:","styles":{}}],"children":[]},{"id":"2e527dbe-bdc2-4da1-8b62-f7718a1ea1a8","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-61.png","url":"assets/image-61.png","caption":"","showPreview":true},"children":[]},{"id":"51ccd6be-8ad1-4774-a9be-18fbd7ac6a3e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"79d0ca6f-3b53-44fc-9ef3-51ac17eba362","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Collapsing the ","styles":{}},{"type":"text","text":"Workflow Tools","styles":{"code":true}},{"type":"text","text":" chapter bubbles the indicator up to the Chapter-level block.","styles":{}}],"children":[]},{"id":"f5fd1184-d7b3-4913-b98b-3da2d679a1e0","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-62.png","url":"assets/image-62.png","caption":"","showPreview":true},"children":[]},{"id":"d312d9f7-5db3-4e37-bbd3-6a28d554bc42","type":"divider","props":{},"children":[]},{"id":"14d5fce7-db3f-4584-b726-ab1d315aff56","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":2,"isToggleable":false},"content":[{"type":"text","text":"Snapshots & Memories","styles":{}}],"children":[]},{"id":"32a69479-2416-4483-afb4-e71ca0aa6dce","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Snapshots capture the changes that have been made across the project since the last snapshot was taken. Snapshots describe the state of changed documents, not necessarily the state of the entire project. ","styles":{}}],"children":[]},{"id":"72c8e5f4-b6e7-4fb7-971f-a03a2f77be86","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"To illustrate, follow these steps:","styles":{}}],"children":[]},{"id":"156821da-f804-4ef8-96a2-1fee8daab251","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Type something in this scene. Notice the yellow indicator next to the scene \"Version Control in Foma\".","styles":{}}],"children":[]},{"id":"af6b83a1-8cc2-4b0c-9b44-ace848f3b4f2","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-67.png","url":"assets/image-67.png","caption":"","showPreview":true},"children":[]},{"id":"19bd6c35-7c5d-4bc4-8b45-7b08e9314c5d","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","start":2},"content":[{"type":"text","text":"Click on the ","styles":{}},{"type":"text","text":"Loremaster's Memory","styles":{"code":true}},{"type":"text","text":" icon in the upper-right corner of the title bar.","styles":{}}],"children":[]},{"id":"913a1dbc-ee60-4835-8510-3b130d8f9239","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-68.png","url":"assets/image-68.png","caption":"","showPreview":true},"children":[]},{"id":"7c10b0fa-7a15-453d-855b-5818915ef8bb","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","start":3},"content":[{"type":"text","text":"You will see a list of outstanding changes at the top of the ","styles":{}},{"type":"text","text":"Loremaster's Memory","styles":{"code":true}},{"type":"text","text":" menu. This will include any other changes that have been made in the project since the last snapshot. ","styles":{}}],"children":[]},{"id":"2cbf39a9-1e45-41c0-bdb6-e386583b86ea","type":"image","props":{"textAlignment":"center","backgroundColor":"default","name":"image-69.png","url":"assets/image-69.png","caption":"Changes that have been made since the last time a snapshot was taken","showPreview":true},"children":[]},{"id":"d4998026-ffd8-40c6-bf6b-e72cb82e58d1","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"f7517cbe-5c6b-479e-990e-3e41e36619a1","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Changes to text are interactive. To see exactly which lines changed, click on the name of the document that has been changed to expand. Additions are ","styles":{}},{"type":"text","text":"green","styles":{"textColor":"green"}},{"type":"text","text":". Subtractions are ","styles":{}},{"type":"text","text":"red","styles":{"textColor":"red"}},{"type":"text","text":".","styles":{}}],"children":[]},{"id":"3d760f82-fe03-46a4-a5d1-6a2c3198a928","type":"image","props":{"textAlignment":"center","backgroundColor":"default","name":"image-70.png","url":"assets/image-70.png","caption":"Images that have been added to a document are represented as Markdown","showPreview":true},"children":[]},{"id":"8bb59bd9-316d-4188-82b9-e075bfc09484","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"0a6046c6-3389-40ff-9155-17c2fb35eb2b","type":"callout","props":{"textAlignment":"left","textColor":"default","icon":"💬"},"content":[{"type":"text","text":"NOTE: you may see the entire contents of this interactive tutorial as outstanding changes if you haven't taken a snapshot yet. That is fine. They will become part of the first snapshot.","styles":{"italic":true}}],"children":[]},{"id":"11cd4458-861a-4bb2-92ee-eaae7a0d77fb","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"cb6e9a9f-6db6-4862-bf3f-4d22ffe3ba24","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Undoing Work","styles":{}}],"children":[]},{"id":"e00ffdf9-8057-466d-a006-2b7291d096dd","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"You may notice that, as you hover over the name of a scene, chapter, or Worldbuilding block in the side bar, a \"Discard changes\" button appears next to the ones that have a yellow save state indicator.","styles":{}}],"children":[]},{"id":"5d177d99-0e4e-4b61-b0b1-afbf08d389cc","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-71.png","url":"assets/image-71.png","caption":"","showPreview":true},"children":[]},{"id":"3fd3d2d2-b855-43f0-9518-ffc4b57be69e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The \"Discard changes\" button only rewinds the document to the last snapshot. For example, if a document was last snapped at 100 words and you type 5 more words in the document, clicking the \"Discard changes\" button next to the document in the side bar will rewind the 5 words that were added since the last memory.","styles":{}}],"children":[]},{"id":"c7d84487-9051-4a15-963c-b010cdb451e4","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"473b201f-832e-4204-95e2-586350aae284","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Reverting Work","styles":{}}],"children":[]},{"id":"e1b797a3-2438-4d7e-9030-3ad9a1c50905","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Reverting work is different from undoing work in that a \"reverting\" rewinds to the state the work was in during a previous snapshot. If you have committed 3 snapshots to memory and click \"Restore to this memory\" in the ","styles":{}},{"type":"text","text":"Loremaster's Memory","styles":{"code":true}},{"type":"text","text":" menu, the Loremaster will rewind to the project's state when that memory was created.","styles":{}}],"children":[]},{"id":"f6387ea7-f1ec-47d7-ae66-bcc8a951f54d","type":"image","props":{"textAlignment":"center","backgroundColor":"default","name":"image-73.png","url":"assets/image-73.png","caption":"","showPreview":true},"children":[]},{"id":"43fc4923-72a3-441d-8a59-74cc1e4170f4","type":"divider","props":{},"children":[]},{"id":"97f170c1-aa53-4532-a334-097343f9ddd4","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Creating Snapshots & Memories","styles":{}}],"children":[]},{"id":"1202a1b6-3113-48b6-828f-fc11e8a9ab9e","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"A snapshot is an image of all of the changes that have been made in the project since the last time a snapshot was taken. A memory is a collection of snapshots rolled up together. Most of the time, this distinction does not matter, as the workflow is designed to sync a single snapshot as a memory automatically, but there are some edge cases where it may be helpful to understand the distinction.","styles":{}}],"children":[]},{"id":"42f68073-7d9e-49aa-97ce-7dfb5b8b92a6","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"e2ea3f47-9f72-4438-b744-b41dfce8022f","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"There are several ways to create a Snapshot or Memory:","styles":{}}],"children":[]},{"id":"5ce56390-f00b-406f-8d4a-0e6ec57ea362","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"From the Loremaster's Memory menu","styles":{}}],"children":[]},{"id":"f2ad8737-dcda-45c3-9584-4f0fc116d43c","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"\tAccess the ","styles":{}},{"type":"text","text":"Loremaster's Memory","styles":{"code":true}},{"type":"text","text":" menu from the upper-right corner of the title bar. Click \"Remember\" to create a snapshot of all outstanding saved work. Then, click ","styles":{}},{"type":"text","text":"Sync to Archive","styles":{"code":true}},{"type":"text","text":" to send those snapshots to your GitHub repository. ","styles":{}}],"children":[]},{"id":"2150cbc3-6298-42fb-90a8-2e88d1960e29","type":"callout","props":{"textAlignment":"left","textColor":"default","icon":"💬"},"content":[{"type":"text","text":"NOTE: You can also skip the \"Remember\" button and click \"Sync to Archive\" if you don't care about describing the unit of work that you're remembering. Foma will create an automatically-titled snapshot and sync it in one action.","styles":{"italic":true}}],"children":[]},{"id":"ac8156e8-891e-4236-9b08-de6cccbda469","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","start":2},"content":[{"type":"text","text":"From the Archive menu","styles":{}}],"children":[]},{"id":"211e57e6-1e92-4aa1-b1c9-149333dc21ee","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Click the Archive button in the upper-right corner of the title bar. Then, click \"Sync to Archive\" to automatically remember and sync your work.","styles":{}}],"children":[]},{"id":"aaa6edf4-5a1d-4985-9c00-ad508b49a632","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","start":3},"content":[{"type":"text","text":"Inside the Editor using either the ","styles":{}},{"type":"text","text":"/save","styles":{"code":true}},{"type":"text","text":" or ","styles":{}},{"type":"text","text":"/memory","styles":{"code":true}},{"type":"text","text":" command.","styles":{}}],"children":[]},{"id":"68afc806-b54c-41ca-ace0-c491238eea8f","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Using the ","styles":{}},{"type":"text","text":"/save","styles":{"code":true}},{"type":"text","text":" command opens a popup to insert a description. After describing the unit of work, hit Enter. A memory will be created and synced to GitHub automatically.","styles":{}}],"children":[]},{"id":"4777699a-621a-4f74-af04-39ea57352881","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-81.png","url":"assets/image-81.png","caption":"Type /save to expose the save memory command","showPreview":true},"children":[]},{"id":"3e852c31-becd-448e-900a-85f95a4d2cf5","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-82.png","url":"assets/image-82.png","caption":"Type a meaningful message and hit \"Enter\" or click \"Sync\" to snapshot+ sync in one action","showPreview":true},"children":[]},{"id":"6c1271c3-32de-4707-8dee-97ee8a3050c2","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"75484c16-1069-4af3-bffc-8375798c38b4","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","start":4},"content":[{"type":"text","text":"For Git power users, Foma also exposes a Git terminal so that you have full control of all of the power that Git has to offer. This terminal can be accessed with the ","styles":{}},{"type":"text","text":"/git","styles":{"code":true}},{"type":"text","text":" command or by accessing ","styles":{}},{"type":"text","text":"Settings","styles":{"code":true}},{"type":"text","text":" → ","styles":{}},{"type":"text","text":"Tools","styles":{"code":true}},{"type":"text","text":" → ","styles":{}},{"type":"text","text":"Git Terminal","styles":{"code":true}},{"type":"text","text":".","styles":{}}],"children":[]},{"id":"d41572ee-2a4a-46df-960f-203db1f46451","type":"image","props":{"textAlignment":"center","backgroundColor":"default","name":"image-64.png","url":"assets/image-64.png","caption":"","showPreview":true},"children":[]},{"id":"29240a38-8edf-43d6-9f78-bac628a3b32c","type":"callout","props":{"textAlignment":"left","textColor":"default","icon":"💬"},"content":[{"type":"text","text":"NOTE: do not use the Git Terminal directly unless you are ","styles":{"italic":true}},{"type":"text","text":"extremely","styles":{"italic":true,"underline":true}},{"type":"text","text":" confident in your Git skills. Foma has intentional guardrails in place to help writers use Git for a writing workflow that may be difficult to see unless you understand how the underlying structures of Foma projects relate to each other, how to resolve merge conflicts, and how to leverage branching/rebasing/reverting to restore a project to the last-known working state.","styles":{"italic":true}}],"children":[]},{"id":"fea54b5e-5769-462d-b357-b58036fa1375","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"ecd51699-e5ca-47b9-8afe-87cbf6924f06","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Sync State Indicators","styles":{}}],"children":[]},{"id":"2be641d4-bc1d-41fa-8418-98f3f4d5b781","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"We have already covered the save state indicator that indicates that a document has been edited since the last time a snapshot was taken and/or synced. When you create a snapshot, the save state indicator changes. Foma produces three different sync states:\n","styles":{}}],"children":[]},{"id":"4e2005ee-2796-441a-85fc-677423dc93e8","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Saved locally — no snapshot","styles":{}}],"children":[]},{"id":"841912dd-cac3-43c5-9bd6-215784602665","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-74.png","url":"assets/image-74.png","caption":"","showPreview":true},"children":[]},{"id":"23496672-510d-4a04-8db1-1c37b7702f53","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","start":2},"content":[{"type":"text","text":"Snapshot created — not synced","styles":{}}],"children":[]},{"id":"5c6f831f-5b77-454f-ad35-b7f982a310ae","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-76.png","url":"assets/image-76.png","caption":"","showPreview":true},"children":[]},{"id":"2d970fe8-678f-483a-9b7f-714e4ffd0104","type":"numberedListItem","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","start":3},"content":[{"type":"text","text":"Snapshot — created & synced","styles":{}}],"children":[]},{"id":"c44415ef-391e-4a5c-bf56-58ef0828efb4","type":"image","props":{"textAlignment":"left","backgroundColor":"default","name":"image-77.png","url":"assets/image-77.png","caption":"","showPreview":true},"children":[]},{"id":"62a52c72-83f1-43ad-a7d6-d52c8889affb","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"542b1256-4c8b-42a9-847c-0cb1446a278b","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"The indicators also persist in the side bar on a per-document basis. If a chapter or block has nested content with differing sync states and the user collapses the parent folder, the state that is furthest from syncing is what rolls up as the parent indicator.","styles":{}}],"children":[]},{"id":"61b60cc6-0ccd-4fa3-b6cc-742849ce3268","type":"image","props":{"textAlignment":"center","backgroundColor":"default","name":"image-78.png","url":"assets/image-78.png","caption":"This chapter contains documents at different sync states","showPreview":true},"children":[]},{"id":"36708f24-73bd-45b9-b74e-13f55f151beb","type":"image","props":{"textAlignment":"center","backgroundColor":"default","name":"image-79.png","url":"assets/image-79.png","caption":"When rolled up, the \"saved--not synced\" status wins out","showPreview":true},"children":[]},{"id":"9d8c1c5f-e479-4858-8995-ca74245066cc","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"28501d2a-61e4-4040-aa50-7d17aba5c72a","type":"heading","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left","level":3,"isToggleable":false},"content":[{"type":"text","text":"Automatic Sync","styles":{}}],"children":[]},{"id":"a9ada544-569d-490f-ba41-7964440d2b11","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"If you are concerned about forgetting to create and sync memories to your remote GitHub archive, Foma can automatically create memories and sync them on a timer. Auto-memory and auto-sync settings are configured in ","styles":{}},{"type":"text","text":"Settings → Memory","styles":{"code":true}},{"type":"text","text":".","styles":{}}],"children":[]},{"id":"6ee20a3a-fb9c-4d30-bf3e-abf30c4ba908","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"7f2141de-77ac-4078-a52d-794e5882aa0d","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[{"type":"text","text":"Auto-memories can be configured to fire every 5, 10, 30, or 60 minutes. However, automatically creating a memory does NOT mean that your work will be synced automatically. To ensure that auto-memories are auto-synced, set your desired Auto-memory interval and toggle \"Auto-sync on auto-memory\" on.","styles":{}}],"children":[]},{"id":"77ddfda4-758b-4096-9070-7eee9aa3282e","type":"image","props":{"textAlignment":"center","backgroundColor":"default","name":"image-80.png","url":"assets/image-80.png","caption":"","showPreview":true},"children":[]},{"id":"9bc57aef-849b-45fa-8f62-7407f1822ddb","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"4df654f6-cd44-45fe-bf7f-1905780b91b4","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]},{"id":"7ac6213c-fdd1-4304-afe4-0c82a422b60c","type":"paragraph","props":{"backgroundColor":"default","textColor":"default","textAlignment":"left"},"content":[],"children":[]}]